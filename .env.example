# `task setup` generates a real .env with random values (scripts/make-env.sh).
# This file only documents the variables.
POSTGRES_ROOT_PASSWORD=
VAULT_DEV_ROOT_TOKEN=
# What the gateway presents to the MCP server. Agents never get this one; they present a JWT from Vault instead.
UPSTREAM_KEY=
# 64 hex characters, encrypts MCP session IDs issued by the gateway.
SESSION_KEY=
LLM_MODEL=qwen2.5:3b
